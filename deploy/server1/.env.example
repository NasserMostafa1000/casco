# Copy to .env and fill in. Never commit .env.

# ---- Caddy ----
APP_DOMAIN=casco.studio
SITES_DOMAIN=casco.studio
ACME_EMAIL=you@example.com

# ---- Database (server 2) ----
Database__Provider=Postgres
ConnectionStrings__Default=Host=SERVER2_IP;Port=5432;Database=casco;Username=casco;Password=CHANGE_ME;SSL Mode=Require;Maximum Pool Size=30

# ---- Security ----
# openssl rand -base64 48
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- App ----
# The UI is on Cloudflare Pages (casco.studio, built with VITE_API_URL=https://api.casco.studio); the API is here.
# To let the API serve the UI itself instead: PublicUrl=https://casco.studio and leave FrontendUrl empty.
App__PublicUrl=https://api.casco.studio
App__FrontendUrl=https://casco.studio
App__Hosts__0=casco.studio
App__Hosts__1=www.casco.studio
App__Hosts__2=api.casco.studio
App__SitesDomain=casco.studio
App__SitesScheme=https
App__CnameTarget=sites.casco.studio
App__ServerIps__0=SERVER1_IP
App__ServerIps__1=SERVER2_IP
# server1 on this machine, server2 on the database machine. Empty = this process always runs background jobs (local dev).
App__ServerId=server1
App__CorsOrigins__0=https://casco.studio
App__CorsOrigins__1=https://www.casco.studio
App__AdminEmails__0=you@example.com

# ---- AI (cheap models by default; switch models from the admin page) ----
Ai__Providers__openai__ApiKey=
Ai__Providers__gemini__ApiKey=

# ---- Google / Apple sign-in (comma-separated client IDs; the first is used by the web button) ----
# Google: OAuth client (Web) -> add https://casco.studio to "Authorized JavaScript origins".
Auth__Google__ClientIds=
# Apple: the web Services ID -> add casco.studio as domain and https://casco.studio/login as return URL.
Auth__Apple__ClientIds=

# ---- Cloudflare Turnstile (bot check on sign-up; add casco.studio to the widget's hostnames) ----
Turnstile__SiteKey=
Turnstile__Secret=

# ---- Uploaded images: Local (./data/uploads) or R2 ----
# R2 API token needs "Object Read & Write" on the bucket below.
# PublicUrl is the bucket's public custom domain (Cloudflare CDN). Visitors then load images,
# videos and product files from Cloudflare, not from this server. Leave it empty only for local dev.
# In the R2 bucket: Settings → Public access → Custom domains → cdn.casco.studio, and allow public access.
Storage__Provider=R2
Storage__R2__ServiceUrl=https://ACCOUNT_ID.r2.cloudflarestorage.com
Storage__R2__BucketName=
Storage__R2__AccessKey=
Storage__R2__SecretKey=
Storage__R2__KeyPrefix=casco
Storage__R2__PublicUrl=https://cdn.casco.studio
# Purges cdn.casco.studio when a site is deleted. Token needs Zone.Cache Purge on this zone.
Cloudflare__ApiToken=
Cloudflare__ZoneId=

# ---- TikTok Events API (server-side). Token is generated in Events Manager and is not stored by TikTok. ----
# Leave TestEventCode empty in production. A test code keeps events out of campaign data.
TikTok__PixelId=DAV5303C77U3N3HES4FG
TikTok__AccessToken=
TikTok__TestEventCode=

# ---- Per-site hosting (minor units: 500 = $5). Yearly = monthly x YearlyPricedMonths ----
Billing__Hosting__StaticMonthlyMinor=500
Billing__Hosting__BackendMonthlyMinor=1000
Billing__Hosting__YearlyPricedMonths=10
Billing__Hosting__GraceDays=3

# ---- Unit economics (admin report): named monthly costs are edited in Admin → pricing; these are fallbacks ----
Billing__Economics__InfraMonthlyUsd=30
Billing__Economics__PaymentFeePercent=3

# ---- E-mail (server alerts, payment reminders, receipts, new orders). Port 587 + STARTTLS. ----
# The provider (Resend / Brevo / Amazon SES / ZeptoMail) must verify casco.studio; add its SPF/DKIM records in Cloudflare DNS.
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=Casco <no-reply@casco.studio>
Smtp__EnableSsl=true

# ---- Monitoring: both servers are checked every minute; alerts go to these addresses ----
Monitor__AlertEmails__0=nasermostafa.ma122@gmail.com
Monitor__AlertLanguage=ar
# Same value as MONITOR_TOKEN in server 2's .env.  openssl rand -hex 32
Monitor__AgentToken=
# Optional limits (warning / critical, percent):
# Monitor__Disk__Warning=85
# Monitor__Disk__Critical=95
# Monitor__Memory__Warning=90
# Monitor__Cpu__Warning=85

# ---- Ziina (requires a Ziina Business account) ----
Ziina__ApiKey=
# openssl rand -hex 32
Ziina__WebhookSecret=
Ziina__TestMode=true
# Webhooks are accepted only from Ziina's IPs (3.29.184.186, 3.29.190.95, 20.233.47.127, 13.202.161.181).
Ziina__EnforceIpAllowlist=true
