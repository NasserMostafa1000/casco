{
	email {$ACME_EMAIL}

	# Customer custom domains get a certificate only if the API recognises them.
	on_demand_tls {
		ask http://api:8080/internal/caddy/ask
	}

	# Real visitor IP when traffic comes through Cloudflare (used for rate limiting).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(api) {
	# Live code streams (server-sent events) must not be buffered by compression.
	@compressible not path /api/tasks/*/stream
	encode @compressible zstd gzip
	reverse_proxy api:8080 {
		flush_interval -1
		header_up X-Forwarded-For {client_ip}
	}
}

# Builder app + published sites on *.SITES_DOMAIN, proxied by Cloudflare (Cloudflare Origin Certificate).
# APP_DOMAIN and SITES_DOMAIN may be the same domain (casco.studio): www is then matched before the wildcard.
{$APP_DOMAIN}, www.{$APP_DOMAIN}, *.{$SITES_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	import api
}

# Customer custom domains (CNAME -> sites.SITES_DOMAIN, DNS only): Let's Encrypt on demand.
https:// {
	tls {
		on_demand
	}
	import api
}
