# Copy to .env. Use the same password in server 1's ConnectionStrings__Default.
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ---- Resource monitor (monitor.sh) ----
# Same value as Monitor__AgentToken in server 1's .env.  openssl rand -hex 32
MONITOR_TOKEN=CHANGE_ME
MONITOR_URL=https://api.casco.studio/api/internal/metrics

# failover.env is created by deploy (not this file). It needs CLOUDFLARE_API_TOKEN
# with Zone.DNS edit on casco.studio, or DNS cannot move when server 1 fails.
